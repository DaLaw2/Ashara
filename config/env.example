# Server configuration read from the environment (`just` loads a .env file at the repository root).
# Copy the lines you need into .env; nothing reads this file.

# Resource caps of every cell and every environment image build. Required: the
# server refuses to boot when one is unset or malformed (CellLimitsInvalid); there is no default in
# code. At MAX_BATCH_SIZE=2 two task cells plus a check cell or an image build run at once, so the
# example values below need about 16 GiB and 16 CPUs free beside Postgres and the server; scale
# them to your host.
#   memory: a whole number with an optional b, k, m or g suffix; swap beyond it is denied
#   cpus:   CPUs, at least 0.01, at most two decimals
#   pids:   the most processes and threads one cell holds at once (image builds get no pids cap:
#           podman build has no --pids-limit)
ASHARA_CELL_MEMORY=4g
ASHARA_CELL_CPUS=4
ASHARA_CELL_PIDS_LIMIT=1024
