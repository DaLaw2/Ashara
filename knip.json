{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "tags": ["-testseam"],
  "ignoreBinaries": ["podman", "setsid"],
  "workspaces": {
    ".": {
      "entry": ["scripts/check-boundaries.ts", "scripts/check-docs.ts", "scripts/secret-key-init.ts", "scripts/secret.ts", "scripts/client.ts", "scripts/project.ts", "scripts/probes.ts", "scripts/run-report.ts", "scripts/simulate.ts", "scripts/replay-run-state.ts", "scripts/affected-tests.ts", "scripts/hidden-suite.ts", "scripts/pool-select.ts"],
      "project": ["scripts/**/*.ts", "!scripts/**/*.test.ts"],
      "vitest": false,
      "ignoreDependencies": ["yaml"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    },
    "packages/integration": {
      "entry": ["src/cell-leak-guard.ts", "src/test-images-guard.ts", "src/test-cells.ts", "src/simulator/simulator-harness.ts"],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false,
      "ignoreDependencies": ["@ashara/knowledge", "@hono/node-server", "ai", "hono"]
    },
    "packages/server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    }
  }
}
