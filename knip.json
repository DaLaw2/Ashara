{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/check-boundaries.ts", "scripts/check-docs.ts", "scripts/secret-key-init.ts", "scripts/secret.ts"],
      "project": ["scripts/**/*.ts", "!scripts/**/*.test.ts"],
      "vitest": false
    },
    "packages/*": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    },
    "packages/agent-runner": {
      "entry": ["src/runner.ts"],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false,
      "ignoreBinaries": ["podman"]
    },
    "packages/server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false,
      "ignoreBinaries": ["podman"]
    }
  }
}
