{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/check-boundaries.ts", "scripts/check-docs.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/agent-runner": {
      "entry": ["src/runner.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/development": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/memory": {
      "ignoreDependencies": [
        "@ashara/shared"
      ]
    },
    "packages/orchestrator": {
      "ignoreDependencies": [
        "@ashara/agent-runner",
        "@ashara/llm-gateway",
        "@ashara/memory"
      ]
    },
    "packages/server": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["podman"]
    }
  }
}
