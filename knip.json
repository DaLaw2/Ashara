{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "tags": ["-testseam"],
  "workspaces": {
    ".": {
      "entry": ["scripts/check-boundaries.ts", "scripts/check-docs.ts", "scripts/secret-key-init.ts", "scripts/secret.ts", "scripts/client.ts"],
      "project": ["scripts/**/*.ts", "!scripts/**/*.test.ts"],
      "vitest": false
    },
    "packages/*": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    },
    "packages/server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    }
  }
}
