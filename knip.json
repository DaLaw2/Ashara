{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "tags": ["-testseam"],
  "ignoreBinaries": ["podman", "setsid"],
  "workspaces": {
    ".": {
      "entry": ["scripts/check-boundaries.ts", "scripts/check-comments.ts", "scripts/check-docs.ts", "scripts/secret-key-init.ts", "scripts/secret.ts", "scripts/client.ts", "scripts/project.ts", "scripts/probes.ts", "scripts/run-report.ts", "scripts/simulate.ts", "scripts/replay-run-state.ts", "scripts/affected-tests.ts", "scripts/test-run-profile.ts", "scripts/hidden-suite.ts", "scripts/pool-select.ts", "scripts/pool-mapping.ts", "scripts/tree-digest.ts", "scripts/trust-record.ts", "scripts/trust-ledger.ts", "scripts/worktree-setup.ts", "scripts/test-db-ready.ts", "scripts/scratch-root-guard.ts"],
      "project": ["scripts/**/*.ts", "!scripts/**/*.test.ts"],
      "vitest": false,
      "ignoreDependencies": ["yaml"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    },
    "packages/integration": {
      "entry": ["src/cell-leak-guard.ts", "src/loop-over-test-db.ts", "src/test-podman-store-guard.ts", "src/test-images-guard.ts", "src/test-database-setup.ts", "src/test-cells.ts", "src/test-sequencer.ts", "src/server/terminal-sweeps.ts", "src/server/replan-store-suite.ts", "src/simulator/simulator-harness.ts"],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false,
      "ignoreDependencies": ["@ashara/knowledge", "@hono/node-server", "hono"]
    },
    "packages/server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "vitest": false
    }
  }
}
