tring","description":"Directory or file to search; defaults to the workspace root."}},"required":["pattern"],"additionalProperties":false}},"run_command":{"description":"Run a shell command in the workspace root and return its exit code, stdout and stderr. Use it for build, test and other shell operations, not to read, write or search files.","inputSchema":{"type":"object","properties":{"command":{"type":"string","description":"The shell command."},"timeout_seconds":{"type":"integer","minimum":1,"description":"Optional; capped by the attempt's per-command limit."}},"required":["command"],"additionalProperties":false}},"finish":{"description":"End the attempt. status \\"done\\": every deliverable exists and passes its checks. status \\"blocked\\": you cannot proceed; blockedReason says what is missing and blockedOn whose it is to provide (another task's work, the client's decision, or other).","inputSchema":{"type":"object","properties":{"status":{"type":"string","enum":["done","blocked"]},"summary":{"type":"string","description":"What you changed, in 1-2 sentences."},"blockedReason":{"type":"string","description":"Required when status is \\"blocked\\"."},"blockedOn":{"type":"object","description":"Required when status is \\"blocked\\": whose it is to clear. \\"needs-work\\": interfaceEntries names, by key as the brief's Public interface lists them, the entries another task must deliver first; you wait for it, the attempt not counted. \\"needs-client-decision\\": only the client can decide (e.g. the tender contradicts itself); question goes to the client as written, assumption is what the tender and vision say now; you wait for the answer, the attempt not counted. \\"other\\": anything else; the attempt counts as failed.","properties":{"kind":{"type":"string","enum":["needs-work","needs-client-decision","other"]},"interfaceEntries":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":20},"question":{"type":"string","maxLength":2000},"assumption":{"type":