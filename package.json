{
  "name": "ashara",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.8.0",
    "eslint-plugin-import-x": "4.17.1",
    "knip": "6.29.0",
    "playwright": "1.58.2",
    "smol-toml": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:full": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  }
}
