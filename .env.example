# Bootstrap config — these cannot be stored in DB (needed to connect to DB)
DATABASE_URL=postgresql://ashara:ashara@localhost:5432/ashara
ASHARA_API_TOKEN=your-secret-token-here

# Optional: LLM provider API keys (can also be configured via DB)
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: per-provider spend cap in USD. Name is the lowercase provider
# name (matches ProviderConfig.name, e.g. anthropic, deepseek, openai).
# Checked against the server's in-memory BudgetLedger (single process,
# ADR-022), which resets to $0 on every server restart — same as
# ASHARA_BUDGET_TOTAL.
# ASHARA_BUDGET_PROVIDER_ANTHROPIC=15
